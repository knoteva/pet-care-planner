{
  "name": "pet-care-planner",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "pet-care-web",
    "pet-care-mobile",
    "pet-care-shared"
  ],
  "scripts": {
    "dev:web": "npm run dev -w pet-care-web",
    "dev:mobile": "npm run start -w pet-care-mobile --",
    "build:web": "npm run build -w pet-care-web",
    "lint:web": "npm run lint -w pet-care-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --check .",
    "db:generate": "npm run db:generate -w pet-care-web",
    "db:migrate": "npm run db:migrate -w pet-care-web",
    "db:studio": "npm run db:studio -w pet-care-web",
    "db:check": "npm run db:check -w pet-care-web",
    "db:ping": "npm run db:ping -w pet-care-web",
    "db:seed": "npm run db:seed -w pet-care-web",
    "smoke:web": "npm run smoke -w pet-care-web",
    "smoke:api": "node scripts/smoke-api.mjs",
    "test:smoke": "npm run smoke:web",
    "test:contracts": "node scripts/check-contracts.mjs",
    "test": "npm run typecheck && npm run test:smoke && npm run test:contracts",
    "db:seed:large": "npm run db:seed:large -w pet-care-web",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "prettier": "^3.6.2"
  }
}
